   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 4 — Build the CUDA extension\n",
    "# Compiles snn_forward.cu + GPU attribute modules into snn_cuda.snn_forward\n",
    "# This takes ~60-90 seconds the first time.\n",
    "import subprocess, sys\n",
    "\n",
    "result = subprocess.run(\n",
    "    [sys.executable, \"src/learning/setup.py\", \"build_ext\", \"--inplace\"],\n",
    "    capture_output=True, text=True\n",
    ")\n",
    "print(result.stdout[-3000:] if len(result.stdout) > 3000 else result.stdout)\n",
    "if result.returncode != 0:\n",
    "    print(\"STDERR:\", result.stderr[-2000:])\n",
    "    raise RuntimeError(\"Build failed — see output above.\")\n",
    "print(\"\\nBuild successful.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 5 — Quick smoke test: import and run the kernel\n",
    "import sys\n",
    "sys.path.insert(0, \"/content/SNNs-auf-GPUs\")\n",
    "\n",
    "import torch\n",
    "import snn_cuda.snn_forward as lif\n",
    "\n",
    "B, N, T = 4, 512, 25\n",
    "input   = torch.rand(B, N, T, device=\"cuda\")\n",
    "voltage = torch.zeros(B, N,   device=\"cuda\")\n",
    "\n",
    "# Standard forward\n",
    "spikes = lif.forward(input, voltage, v_th=1.0, tau_inv=0.1)\n",
    "print(f\"Standard forward\")\n",
    "print(f\"  Output shape : {tuple(spikes.shape)}\")\n",
    "print(f\"  Spike rate   : {spikes.mean().item()*100:.1f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 6 — Profiled forward: kernel time + energy\n",
    "voltage.zero_()   # reset membrane state\n",
    "\n",
    "spikes, elapsed_ms, pwr_before, pwr_after, energy_mj, nvml_ok = \\\n",
    "    lif.forward_profiled(input, voltage, v_th=1.0, tau_inv=0.1)\n",
    "\n",
    "print(f\"Profiled forward\")\n",
    "print(f\"  Kernel time  : {elapsed_ms:.3f} ms\")\n",
    "print(f\"  Spike rate   : {spikes.mean().item()*100:.1f}%\")\n",
    "if nvml_ok:\n",
    "    print(f\"  Power before : {pwr_before:.1f} mW\")\n",
    "    print(f\"  Power after  : {pwr_after:.1f} mW\")\n",
    "    print(f\"  Energy used  : {energy_mj:.4f} mJ\")\n",
    "else:\n",
    "    print(\"  Power/Energy : N/A (NVML not available on this GPU)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 7 — Throughput benchmark: compare kernel vs PyTorch baseline\n",
    "import time\n",
    "\n",
    "RUNS = 100\n",
    "\n",
    "# Custom CUDA kernel\n",
    "voltage.zero_()\n",
    "torch.cuda.synchronize()\n",
    "t0 = time.perf_counter()\n",
    "for _ in range(RUNS):\n",
    "    lif.forward(input, voltage)\n",
    "torch.cuda.synchronize()\n",
    "kernel_ms = (time.perf_counter() - t0) * 1000 / RUNS\n",
    "\n",
    "# PyTorch baseline (same LIF logic, no custom kernel)\n",
    "def lif_torch(inp, v, v_th=1.0, tau_inv=0.1):\n",
    "    v_new = v * (1.0 - tau_inv) + inp\n",
    "    spk   = (v_new >= v_th).float()\n",
    "    v_new = v_new * (1.0 - spk)\n",
    "    return spk, v_new\n",
    "\n",
    "v_pt = torch.zeros(B, N, device=\"cuda\")\n",
    "torch.cuda.synchronize()\n",
    "t0 = time.perf_counter()\n",
    "for _ in range(RUNS):\n",
    "    for t in range(T):\n",
    "        _, v_pt = lif_torch(input[:, :, t], v_pt)\n",
    "torch.cuda.synchronize()\n",
    "torch_ms = (time.perf_counter() - t0) * 1000 / RUNS\n",
    "\n",
    "print(f\"Custom CUDA kernel : {kernel_ms:.3f} ms / forward\")\n",
    "print(f\"PyTorch baseline   : {torch_ms:.3f} ms / forward\")\n",
    "print(f\"Speedup            : {torch_ms/kernel_ms:.2f}x\")"
   ]
  },
