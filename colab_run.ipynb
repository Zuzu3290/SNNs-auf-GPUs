   "source": [
    "# SNNs auf GPUs — Custom CUDA Kernel (Colab)\n",
    "\n",
    "**Before running anything:**  \n",
    "Go to `Runtime → Change runtime type → T4 GPU → Save`\n",
    "\n",
    "Then run cells top to bottom."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 1 — Confirm GPU is available\n",
    "import torch\n",
    "\n",
    "if not torch.cuda.is_available():\n",
    "    raise RuntimeError(\"No GPU detected. Go to Runtime → Change runtime type → T4 GPU.\")\n",
    "\n",
    "props = torch.cuda.get_device_properties(0)\n",
    "print(f\"GPU         : {props.name}\")\n",
    "print(f\"VRAM        : {props.total_memory / 1e9:.1f} GB\")\n",
    "print(f\"SM arch     : sm_{props.major}{props.minor}\")\n",
    "print(f\"CUDA version: {torch.version.cuda}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cell 2 — Clone the repo and switch to the Operators branch\n",
    "import os\n",
    "\n",
    "REPO = \"/content/SNNs-auf-GPUs\"\n",
